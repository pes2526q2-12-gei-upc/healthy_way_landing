# Backend API base URL (no trailing slash). Leave unset in production Docker builds
# (same-origin /api via nginx). For local dev, leave unset if using Vite proxy (default),
# or set e.g. http://localhost:8080 if the API is on another host without proxy.
# VITE_API_BASE_URL=http://localhost:8080

# Support email for brands (shown on the brand dashboard)
VITE_ADMIN_CONTACT_EMAIL=admin@healthyway.local

# App download URL (defaults to /landing/downloads/healthy-way.apk)
# VITE_APP_DOWNLOAD_URL=https://example.com/healthy-way.apk
